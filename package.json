{
  "name": "first-meet",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-content.mjs",
    "dev": "next dev web",
    "prebuild": "node scripts/copy-content.mjs",
    "build": "next build web",
    "start": "node scripts/migrate.mjs && next start web -p ${PORT:-3000}",
    "typecheck": "tsc -p web --noEmit",
    "lint": "eslint web tests scripts",
    "test": "vitest run",
    "test:judge": "playwright test -c tests/judge.config.ts",
    "test:e2e": "playwright test -c tests/e2e.config.ts",
    "postinstall": "node scripts/copy-mediapipe.mjs && node scripts/copy-content.mjs",
    "db:generate": "node scripts/db-generate.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "vitest run -c tests/db/vitest.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.2",
    "@phosphor-icons/react": "2.1.10",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "postgres": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "ffmpeg-static": "5.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
